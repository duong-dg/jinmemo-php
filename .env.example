APP_ENV=production
APP_NAME=JinMemo
SEO_INDEXING=false
PUBLIC_BASE_URL=https://your-domain.example
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=jingo
DB_USERNAME=jingo
DB_PASSWORD=

# Optional absolute directory outside public; encrypted archives published by your backup job.
# BACKUP_DIR=/home/USER/private-backups

# CLI encrypted database-only backups (private directories: 0700, passphrase file: 0600).
# BACKUP_GPG_BINARY=/usr/bin/gpg
# BACKUP_GPG_HOME=/home/USER/private-gpg
# BACKUP_PASSPHRASE_FILE=/home/USER/private-secrets/backup-passphrase

# Optional coordinated application snapshots: private 0700 directory shared by PHP web and CLI.
# Persist this in .env before enabling application-backup.php.
# BACKUP_COORDINATION_DIR=/home/USER/private-backup-coordination
# BACKUP_GIT_BINARY=/usr/bin/git
